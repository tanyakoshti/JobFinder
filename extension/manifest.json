{
  "manifest_version": 3,
  "name": "Job AI Finder",
  "version": "1.0",
  "description": "Analyze jobs and match your skills using AI",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["content.js"]
    }
  ]
}