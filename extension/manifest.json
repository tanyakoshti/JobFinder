{
  "manifest_version": 3,
  "name": "Job AI Finder",
  "version": "1.0",
  "description": "Discover, analyze, and manage job applications intelligently using AI.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://www.linkedin.com/jobs/*", "https://*.workers.dev/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}